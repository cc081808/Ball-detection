{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ball detection: setup",
      "type": "shell",
      "command": "\"${workspaceFolder}\\1 - Setup.cmd\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "problemMatcher": []
    },
    {
      "label": "Ball detection: check model",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["detect_ball.py", "--check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
